{
  "name": "schreibwerkstatt",
  "version": "6.2.0",
  "description": "Schreibwerkstatt — Schreiben, Lektorat und Buchanalyse mit KI",
  "license": "AGPL-3.0-or-later",
  "main": "server.js",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "prestart": "node scripts/sync-version.js && node scripts/sw-manifest.js",
    "start": "node server.js",
    "version:sync": "node scripts/sync-version.js",
    "sw:manifest": "node scripts/sw-manifest.js",
    "build:bundle": "node scripts/build-bundle.js",
    "test": "npm run test:imports && npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:smoke",
    "test:imports": "node scripts/check-imports.js",
    "test:unit": "DB_FSYNC=off node --test --test-concurrency=4 \"tests/unit/**/*.test.js\" \"tests/unit/**/*.test.mjs\"",
    "test:integration": "DB_FSYNC=off node --test --test-concurrency=4 \"tests/integration/*.test.js\"",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke-parallel.js",
    "test:ci": "node scripts/test-ci.js",
    "test:focus": "playwright test tests/e2e/focus-editor.spec.js tests/e2e/focus-client-contract.spec.js && env -u GIO_MODULE_DIR playwright test --project=webkit tests/e2e/focus-client-contract.webkit.spec.js && playwright test --config=playwright.app.config.js tests/e2e-app/focus-editor-app.spec.js tests/e2e-app/focus-acceptance-app.spec.js",
    "check:clients": "node scripts/check-clients-compat.js",
    "contract:build": "node scripts/contract-build.js",
    "contract:fixtures": "CONTRACT_UPDATE=1 DB_FSYNC=off node --test tests/integration/client-contract.test.js",
    "contract:surface": "node scripts/check-clients-compat.js --write-surface",
    "cache:cleanup": "node scripts/cache-cleanup.js",
    "squash:regen": "node tools/regen-squashed.js",
    "calibrate:tokens": "node scripts/calibrate-chars-per-token.js",
    "eval:lektorat": "node scripts/eval-lektorat.js",
    "shots:landing": "node scripts/landing-shots.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "fake-indexeddb": "^6.2.7",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "altcha-lib": "^2.8.0",
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-session-store": "^0.1.0",
    "compression": "^1.8.2",
    "diff": "^9.0.0",
    "docx": "^9.15.3",
    "dotenv": "^18.0.9",
    "epub-gen-memory": "^1.1.2",
    "esbuild": "0.28.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "hyphenation.de": "^0.2.1",
    "hyphenation.en-us": "^0.2.1",
    "hypher": "^0.2.5",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.9",
    "pdfkit": "^0.20.2",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "unpdf": "^2.1.0",
    "winston": "^3.19.0",
    "word-extractor": "^1.0.4"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "sharp": true
  }
}
