[Unit]
Description=Schreibwerkstatt
After=network.target

[Service]
Type=simple
User=github-runner
WorkingDirectory=/opt/schreibwerkstatt
ExecStart=/usr/bin/node server.js
# always: der Admin-Backup-Restore beendet den Prozess bewusst (Exit 0), damit
# die Pending-DB beim Boot eingeswappt wird. `always` startet nach jedem Exit neu
# (ausser explizitem `systemctl stop`). Gewollte Stopps enden mit 0, Exit != 0
# heisst echter Fehler — darum kein SuccessExitStatus=1.
Restart=always
RestartSec=5
# Groesser als die 30 s Drain von lib/shutdown.js — sonst kommt SIGKILL, bevor
# der Prozess die DB sauber geschlossen hat.
TimeoutStopSec=45
Environment=PORT=3737
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
